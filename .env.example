VITE_GEMINI_API_KEY=masukkan_api_key_gemini_anda_disini

# ==== KONFIGURASI CLOUDFLARE AI ====
# Ada 2 cara memasukkan kredensial Cloudflare:

# OPSI 1: Multi-Akun (Disarankan untuk menghindari limit 429)
# Format: JSON Array berisi objek akun. Server akan otomatis melakukan rotasi (auto-roll) 
# jika akun pertama terkena limit.
# VITE_CLOUDFLARE_CREDENTIALS='[{"accountId":"id_akun_1","apiKey":"kunci_api_1"}, {"accountId":"id_akun_2","apiKey":"kunci_api_2"}]'

# OPSI 2: Single Akun (Cadangan/Standard)
VITE_CLOUDFLARE_ACCOUNT_ID=masukkan_account_id_cloudflare_anda
VITE_CLOUDFLARE_API_KEY=masukkan_api_key_cloudflare_anda
